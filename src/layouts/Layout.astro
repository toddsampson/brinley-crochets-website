---
import '../styles/global.css';
import site from '../data/site.json';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  /** 'all' for the home page, a category slug for category pages. */
  activeNav?: string;
  /** On a post page: show other posts in the sidebar, excluding this one. */
  currentPostId?: string;
}

const { title, description, image, activeNav, currentPostId } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : `${site.title} | ${site.tagline}`;
const metaDescription = description || site.tagline;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header activeNav={activeNav} />
    <div class="mx-auto grid w-full max-w-6xl flex-1 gap-10 px-4 py-10 lg:grid-cols-[minmax(0,1fr)_300px]">
      <main>
        <slot />
      </main>
      <Sidebar currentPostId={currentPostId} />
    </div>
    <Footer />
  </body>
</html>
