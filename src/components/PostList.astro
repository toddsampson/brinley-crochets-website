---
import PostCard from './PostCard.astro';
import type { PostPage } from '../utils/posts';
import { getCategoryMap } from '../utils/posts';

interface Props {
  page: PostPage;
  heading?: string;
  description?: string | null;
}

const { page, heading, description } = Astro.props;
const categoryMap = await getCategoryMap();
---

{heading && (
  <div class="mb-8 text-center">
    <h1 class="text-4xl font-bold">{heading}</h1>
    {description && <p class="mt-2 text-ink/70">{description}</p>}
  </div>
)}

{page.posts.length === 0 ? (
  <p class="widget text-center text-ink/70">No posts here yet — check back soon! 🧶</p>
) : (
  <div class="space-y-8">
    {page.posts.map((post) => <PostCard post={post} categoryMap={categoryMap} />)}
  </div>
)}

{(page.prevUrl || page.nextUrl) && (
  <nav class="mt-10 flex justify-between" aria-label="Pagination">
    {page.nextUrl ? <a href={page.nextUrl} class="btn">← Older posts</a> : <span />}
    {page.prevUrl ? <a href={page.prevUrl} class="btn">Newer posts →</a> : <span />}
  </nav>
)}
