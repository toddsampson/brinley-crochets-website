---
import { formatDate, type Post, type Category } from '../utils/posts';

interface Props {
  post: Post;
  categoryMap: Map<string, Category>;
}

const { post, categoryMap } = Astro.props;
const { title, pubDate, updatedDate, excerpt, heroImage, categories, draft } = post.data;
const href = `/posts/${post.id}/`;
---

<article class="flex flex-col overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-black/5 transition hover:-translate-y-0.5 hover:shadow-md">
  <a href={href} class="block aspect-card overflow-hidden bg-blush" tabindex="-1" aria-hidden="true">
    {heroImage ? (
      <img src={heroImage} alt="" class="h-full w-full object-cover transition duration-300 hover:scale-105" loading="lazy" />
    ) : (
      <div class="flex h-full items-center justify-center text-6xl" aria-hidden="true">🧶</div>
    )}
  </a>
  <div class="flex flex-1 flex-col p-5">
    {categories.length > 0 && (
      <div class="mb-3 flex flex-wrap gap-1.5">
        {categories.filter((slug) => categoryMap.has(slug)).map((slug) => (
          <a href={`/category/${slug}/`} class="pill">{categoryMap.get(slug)!.data.title}</a>
        ))}
      </div>
    )}
    <h2 class="text-2xl font-bold leading-tight">
      <a href={href} class="hover:text-teal">{draft && <span class="text-red-500">[Draft] </span>}{title}</a>
    </h2>
    <p class="mt-2 text-xs uppercase tracking-wider text-ink/50">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      {updatedDate && <> · Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></>}
    </p>
    {excerpt && <p class="mt-3 flex-1 text-sm leading-relaxed text-ink/80">{excerpt}</p>}
    <a href={href} class="mt-4 self-start text-sm font-bold uppercase tracking-wider text-teal hover:text-teal-dark">Read more →</a>
  </div>
</article>
